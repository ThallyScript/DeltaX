CreateServerConfig("🔄 Rejoin Server", UDim2.new(0, 0, 0, 0), function() TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer) end)
CreateServerConfig("🎲 Server Hop", UDim2.new(0, 0, 0, 50), function()
    local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local s, r = pcall(function() return game:HttpGet(url) end)
    if s then
        local data = HttpService:JSONDecode(r); local svs = {}
        for _, v in ipairs(data.data) do if v.playing < v.maxPlayers and v.id ~= game.JobId then table.insert(svs, v) end end
        if #svs > 0 then TeleportService:TeleportToPlaceInstance(game.PlaceId, svs[math.random(1, #svs)].id, LocalPlayer) end
    end
end)
CreateServerConfig("📉 Smallest Server", UDim2.new(0, 0, 0, 100), function()
    local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local s, r = pcall(function() return game:HttpGet(url) end)
    if s then
        local data = HttpService:JSONDecode(r); local svs = {}
        for _, v in ipairs(data.data) do if v.playing < v.maxPlayers and v.id ~= game.JobId then table.insert(svs, v) end end
        if #svs > 0 then
            table.sort(svs, function(a, b) return a.playing < b.playing end)
            TeleportService:TeleportToPlaceInstance(game.PlaceId, svs[1].id, LocalPlayer)
        end
    end
end)

