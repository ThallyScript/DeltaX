local Tabs = {}
local Buttons = {}

local function CreateTab(name, icon, yPos)
    local btn = Create("TextButton", {
        Size = UDim2.new(0.85, 0, 0, 35), Position = UDim2.new(0.075, 0, 0, yPos), BackgroundColor3 = Color3.fromRGB(20, 20, 25),
        Text = " " .. icon .. " " .. name, TextColor3 = Color3.fromRGB(200, 200, 200), Font = Enum.Font.GothamMedium, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = Sidebar
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = btn})
    local frame = Create("Frame", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Parent = ContentArea, Visible = false})
    table.insert(Tabs, frame); table.insert(Buttons, btn)
    
    btn.MouseButton1Click:Connect(function()
        for i, t in ipairs(Tabs) do
            t.Visible = (t == frame)
            TweenService:Create(Buttons[i], TweenInfo.new(0.2), {
                BackgroundColor3 = (t == frame) and Color3.fromRGB(80, 100, 255) or Color3.fromRGB(20, 20, 25),
                TextColor3 = (t == frame) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 200, 200)
            }):Play()
        end
    end)
    return frame, btn
end

