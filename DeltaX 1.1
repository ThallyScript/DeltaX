-- Carregador de Imagem em Nuvem com Cache
local function LoadWebImage(imagePath, imageLabel)
    if not imagePath or not writefile or not getcustomasset then return end
    task.spawn(function()
        local fileName = "DeltaX_" .. imagePath:match("([^/]+)$")
        if isfile and isfile(fileName) then
            imageLabel.Image = getcustomasset(fileName) return
        end
        local success, data = pcall(function() return game:HttpGet("https://scriptblox.com" .. imagePath) end)
        if success and data then
            writefile(fileName, data); imageLabel.Image = getcustomasset(fileName)
        end
    end)
end

-- Renderiza os Blocos de Script
local function CreateScriptCard(scrollParent, title, code, imagePath)
    local Card = Create("TextButton", { -- Agora o cartão inteiro é clicável
        BackgroundColor3 = Color3.fromRGB(35, 35, 40), Text = "", AutoButtonColor = false, Parent = scrollParent
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = Card})
    
    local ScriptImg = Create("ImageLabel", {
        Size = UDim2.new(1, 0, 0, 75), BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Crop, Parent = Card
    })
    Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = ScriptImg})
    if imagePath then LoadWebImage(imagePath, ScriptImg) end
    
    local TitleLbl = Create("TextLabel", {
        Size = UDim2.new(1, -10, 1, -80), Position = UDim2.new(0, 5, 0, 80), BackgroundTransparency = 1,
        Text = title, TextColor3 = Color3.fromRGB(220, 220, 220), Font = Enum.Font.Gotham, TextSize = 11,
        TextWrapped = true, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Card
    })
    
    -- Efeito visual de hover
    Card.MouseEnter:Connect(function() TweenService:Create(Card, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(45, 45, 55)}):Play() end)
    Card.MouseLeave:Connect(function() TweenService:Create(Card, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 35, 40)}):Play() end)
    
    -- Quando clica, abre o Modal
    Card.MouseButton1Click:Connect(function()
        ActiveScriptData = {title = title, code = code, image = imagePath}
        ModalTitle.Text = title
        ModalBg.Visible = true
    end)
end

-- Funcionalidade: Buscar na Nuvem
CloudBtn.MouseButton1Click:Connect(function()
    local query = string.gsub(CloudSearch.Text, " ", "%%20")
    if query == "" then return end
    for _, c in pairs(CloudScroll:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
    
    local url = "https://scriptblox.com/api/script/search?q=" .. query .. "&mode=free&max=30&page=1"
    local success, response = pcall(function() return game:HttpGet(url) end)
    if success and response then
        local data = HttpService:JSONDecode(response)
        if data.result and data.result.scripts then
            for _, sc in ipairs(data.result.scripts) do
                CreateScriptCard(CloudScroll, sc.title, sc.script, sc.image)
            end
            CloudScroll.CanvasSize = UDim2.new(0, 0, 0, math.ceil(#data.result.scripts / 3) * 130)
        end
    end
end)

-- Funcionalidade: Buscar nos Salvos Locais
local function LoadSavedScripts()
    for _, c in pairs(SavedScroll:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
    if not listfiles then return end
    
    local files = listfiles(SaveFolder)
    local count = 0
    local filter = string.lower(SavedSearch.Text)
    
    for _, file in ipairs(files) do
        local success, contents = pcall(function() return readfile(file) end)
        if success then
            local data = HttpService:JSONDecode(contents)
            if filter == "" or string.find(string.lower(data.title), filter) then
                CreateScriptCard(SavedScroll, data.title, data.code, data.image)
                count = count + 1
            end
        end
    end
    SavedScroll.CanvasSize = UDim2.new(0, 0, 0, math.ceil(count / 3) * 130)
end

SavedBtn.MouseButton1Click:Connect(LoadSavedScripts)
