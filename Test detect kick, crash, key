local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- 1. SISTEMA ANTI-KICK E ANTI-CRASH
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    
    -- Bloqueia a função Kick
    if method == "Kick" or method == "kick" then
        warn("⚠️ ALERTA: Um script malicioso tentou te dar kick! Ação bloqueada.")
        return nil -- Cancela o kick
    end
    
    -- Bloqueia teleportes forçados (muitas vezes usados para crashar ou dar erro 268)
    if method == "Teleport" or method == "TeleportToPlaceInstance" then
        warn("⚠️ ALERTA: Um script tentou te teleportar para outro jogo! Ação bloqueada.")
        return nil
    end
    
    return oldNamecall(self, ...)
end)

-- 2. DETECTOR DE GUI SUSPEITA (SISTEMAS DE KEY)
local function verificarGUI(gui)
    -- Aguarda um instante para os textos da GUI carregarem
    task.wait(1) 
    local guiSuspeita = false

    -- Varre todos os textos dentro da GUI injetada
    for _, instance in pairs(gui:GetDescendants()) do
        if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
            local texto = string.lower(instance.Text)
            
            -- Palavras-chave clássicas de scripts de golpe/keys
            if string.find(texto, "get key") or 
               string.find(texto, "linkvertise") or 
               string.find(texto, "discord.gg") or 
               string.find(texto, "pastebin") or
               string.find(texto, "hwid") then
                guiSuspeita = true
                break
            end
        end
    end

    if guiSuspeita then
        warn("🚨 AVISO: Uma GUI suspeita (provável sistema de Key) foi detectada! Nome: " .. gui.Name)
        
        -- DESCOMENTE A LINHA ABAIXO se quiser que o script delete a GUI automaticamente:
        -- gui:Destroy() 
        -- print("🗑️ GUI suspeita deletada com sucesso!")
    end
end

-- Monitora sempre que uma nova GUI for injetada no CoreGui
CoreGui.ChildAdded:Connect(function(child)
    verificarGUI(child)
end)

-- Verifica as GUIs que já estavam abertas
for _, child in pairs(CoreGui:GetChildren()) do
    verificarGUI(child)
end

print("🛡️ Script Anti-Golpe ativado com sucesso! Você está protegido contra Kicks e GUIs de Key.")
